{
  "name": "lead-unmsm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "doctor": "node scripts/repo-doctor.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run doctor && npm run format:check && npm run check && npm run test:unit && npm run build && npm run check:links"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.20.1",
    "astro": "^5.12.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
