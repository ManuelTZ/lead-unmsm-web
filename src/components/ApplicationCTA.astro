---
import { siteConfig } from '@/config/site';
interface Props {
  label?: string;
  className?: string;
  url?: string;
}
const {
  label = 'Postula a LEAD',
  className = '',
  url = siteConfig.applicationFormUrl,
} = Astro.props;
---

{
  !siteConfig.applicationOpen ? (
    <span class={`button button-secondary ${className}`} aria-disabled="true">
      Convocatoria cerrada
    </span>
  ) : url ? (
    <a class={`button button-primary ${className}`} href={url} target="_blank" rel="noreferrer">
      {label}
    </a>
  ) : (
    <span
      class={`button button-secondary ${className}`}
      aria-disabled="true"
      title="Configura PUBLIC_APPLICATION_FORM_URL"
    >
      Formulario pendiente
    </span>
  )
}
