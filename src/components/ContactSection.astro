---
import { contactContent } from '@/data/contact';
---

<section class="contact-section section" id="contacto" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-copy">
      <p class="eyebrow">Conversemos</p>
      <h2 class="section-title" id="contact-title">{contactContent.title}</h2>
      <p>{contactContent.introduction}</p>
      {contactContent.email && <strong>{contactContent.email}</strong>}
    </div>

    <form
      class="contact-form card"
      name="contacto-lead-unmsm"
      method="POST"
      action="/gracias"
      data-netlify="true"
      netlify-honeypot="empresa-web"
    >
      <input type="hidden" name="form-name" value="contacto-lead-unmsm" />
      <p hidden>
        <label>No completar este campo: <input name="empresa-web" autocomplete="off" /></label>
      </p>

      <div class="field full-width">
        <label for="contact-name">Nombre Completo</label>
        <input
          id="contact-name"
          name="nombre"
          type="text"
          placeholder="Tu nombre"
          autocomplete="name"
          required
        />
      </div>

      <div class="field full-width">
        <label for="contact-email">Correo Electrónico</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          placeholder="ejemplo@email.com"
          autocomplete="email"
          required
        />
      </div>

      <div class="field full-width">
        <label for="contact-subject">Asunto</label>
        <select id="contact-subject" name="asunto" required>
          <option value="" selected disabled>Selecciona un asunto</option>
          {contactContent.subjects.map((subject) => <option value={subject}>{subject}</option>)}
        </select>
      </div>

      <div class="field full-width">
        <label for="contact-message">Mensaje</label>
        <textarea
          id="contact-message"
          name="mensaje"
          rows="6"
          placeholder="Escribe tu mensaje aquí..."
          required></textarea>
      </div>

      <button class="button button-primary" type="submit">Enviar Mensaje</button>
    </form>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid var(--ink-800);
    background:
      radial-gradient(circle at 15% 30%, rgba(232, 62, 120, 0.1), transparent 34%), #0c0c10;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 7vw, 88px);
    align-items: start;
  }

  .contact-copy {
    position: sticky;
    top: 112px;
  }

  .contact-copy p:not(.eyebrow) {
    max-width: 520px;
    margin: 24px 0 18px;
    color: #d0d0d6;
    font-size: 1.08rem;
  }

  .contact-copy strong {
    color: var(--rose-300);
  }

  .contact-form {
    display: grid;
    gap: 20px;
    padding: clamp(22px, 4vw, 36px);
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    color: var(--white);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid var(--ink-700);
    border-radius: 10px;
    padding: 12px 14px;
    background: var(--ink-950);
    color: var(--white);
    font: inherit;
  }

  .field textarea {
    min-height: 150px;
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #777782;
  }

  .contact-form .button {
    justify-self: start;
    min-width: 180px;
  }

  @media (max-width: 780px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-copy {
      position: static;
    }

    .contact-form .button {
      width: 100%;
    }
  }
</style>
