---
import { siteConfig } from '@/config/site';

const links = [
  ['/', 'Inicio'],
  ['/eventos', 'Eventos'],
  ['/noticias', 'Noticias'],
  ['/nosotros', 'Nosotros'],
  ['/alianzas', 'Alianzas'],
  ['/perfil', 'Tu perfil'],
] as const;

const pathname = Astro.url.pathname;
const isCurrent = (href: (typeof links)[number][0]) =>
  href === '/' ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Ir al inicio de LEAD UNMSM">
      <picture class="brand-logo" aria-hidden="true">
        <source srcset="/brand/lead-mark.webp" type="image/webp" />
        <img src="/brand/lead-mark.png" width="560" height="337" alt="" decoding="async" />
      </picture>
      <span>{siteConfig.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        links.map(([href, label]) => (
          <a
            class:list={['nav-link', { active: isCurrent(href) }]}
            href={href}
            aria-current={isCurrent(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-nav" data-mobile-nav>
      <summary aria-label="Abrir menú" aria-controls="mobile-navigation" aria-expanded="false"
        >Menú</summary
      >
      <nav id="mobile-navigation" aria-label="Navegación móvil">
        {
          links.map(([href, label]) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-mobile-nav]').forEach((disclosure) => {
    const control = disclosure.querySelector<HTMLElement>('summary');
    if (!control) return;

    const syncState = () => {
      control.setAttribute('aria-expanded', String(disclosure.open));
      control.setAttribute('aria-label', disclosure.open ? 'Cerrar menú' : 'Abrir menú');
    };

    disclosure.addEventListener('toggle', syncState);
    disclosure.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !disclosure.open) return;

      event.preventDefault();
      disclosure.open = false;
      control.focus();
    });
    syncState();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(8, 8, 11, 0.94);
    border-bottom: 1px solid var(--ink-800);
    backdrop-filter: blur(12px);
  }
  .header-inner {
    min-height: 70px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--white);
    text-decoration: none;
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  .brand-logo {
    display: block;
    flex: 0 0 auto;
    width: 56px;
    height: 34px;
  }
  .brand-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-link {
    padding: 9px 10px;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 750;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--white);
    background: var(--ink-850);
  }
  .nav-link.active {
    box-shadow: inset 0 -2px var(--rose-500);
  }
  .mobile-nav {
    display: none;
    position: relative;
  }
  .mobile-nav summary {
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--ink-700);
    border-radius: 8px;
    padding: 8px 11px;
    font-weight: 800;
  }
  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 220px;
    padding: 8px;
    background: var(--ink-900);
    border: 1px solid var(--ink-700);
    border-radius: 12px;
  }
  .mobile-nav a {
    display: block;
    padding: 11px;
    border-radius: 8px;
    color: var(--white);
    text-decoration: none;
  }
  .mobile-nav a:hover,
  .mobile-nav a[aria-current='page'] {
    background: var(--ink-800);
  }
  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>
