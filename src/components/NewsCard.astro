---
import type { NewsArticle } from '@/models/content';
import { formatDate } from '@/lib/date';
interface Props {
  article: NewsArticle;
}
const { article } = Astro.props;
---

<article class="card news-card">
  {
    article.imageSrc && article.imageAlt && (
      <a class="news-image" href={`/noticias/${article.slug}`} tabindex="-1" aria-hidden="true">
        <img
          src={article.imageSrc}
          alt=""
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="news-copy">
    <div class="meta">
      <span class="tag">{article.category}</span><span>{formatDate(article.publishedAt)}</span>
    </div>
    <h3><a href={`/noticias/${article.slug}`}>{article.title}</a></h3>
    <p class="muted">{article.excerpt}</p>
    <span class="author">{article.author}</span>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
  .news-image {
    display: block;
  }
  .news-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--ink-800);
  }
  .news-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  h3 {
    margin: 18px 0 8px;
    font-size: 1.35rem;
    line-height: 1.15;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--rose-300);
  }
  .author {
    margin-top: auto;
    padding-top: 12px;
    color: #d6d6dc;
    font-size: 0.84rem;
  }
</style>
