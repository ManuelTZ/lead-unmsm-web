---
import Countdown from '@/components/Countdown.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { homeContent } from '@/data/home';
import { siteConfig } from '@/config/site';
---

<BaseLayout title="Inicio" description={siteConfig.description}>
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">{homeContent.eyebrow}</p>
      <h1>{homeContent.title}</h1>
      <p class="hero-copy">{homeContent.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={homeContent.primaryAction.href}>
          {homeContent.primaryAction.label}
        </a>
        <a class="button button-secondary" href={homeContent.secondaryAction.href}>
          {homeContent.secondaryAction.label}
        </a>
      </div>
      <Countdown deadline={siteConfig.applicationDeadline} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: min(680px, calc(100svh - 150px));
    align-items: center;
    padding: 80px 0;
  }

  .hero-content {
    max-width: 900px;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.7rem, 8vw, 6.6rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .hero-copy {
    max-width: 660px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: 64px 0 72px;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
