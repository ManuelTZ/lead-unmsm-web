---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/date';
import { contentRepository } from '@/services/content/repository';

export async function getStaticPaths() {
  const news = await contentRepository.listNews();
  return news.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
---

<BaseLayout title={article.title} description={article.excerpt}>
  <article class="section">
    <div class="container article">
      <a class="back" href="/noticias">← Volver a noticias</a>
      <span class="tag">{article.category}</span>
      <h1 class="section-title">{article.title}</h1>
      <p class="meta">{formatDate(article.publishedAt)} · {article.author}</p>
      <p class="dek">{article.excerpt}</p>
      {
        article.imageSrc && article.imageAlt && (
          <img
            class="article-cover"
            src={article.imageSrc}
            alt={article.imageAlt}
            width="1200"
            height="675"
            decoding="async"
          />
        )
      }
      <div class="body">{article.body.map((paragraph) => <p>{paragraph}</p>)}</div>
      {
        article.isDemo && (
          <p class="card muted">Contenido de demostración. Reemplazar antes del lanzamiento.</p>
        )
      }
    </div>
  </article>
</BaseLayout>
<style>
  .article {
    max-width: 820px;
  }
  .back {
    display: block;
    margin-bottom: 26px;
    color: var(--muted);
    text-decoration: none;
  }
  .article h1 {
    margin-top: 18px;
  }
  .meta {
    color: var(--muted);
  }
  .dek {
    font-size: 1.25rem;
    color: #d5d5da;
  }
  .article-cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 30px 0;
    border: 1px solid var(--ink-700);
    border-radius: var(--radius);
    object-fit: cover;
    background: var(--ink-800);
  }
  .body {
    font-size: 1.06rem;
    color: #c5c5cc;
  }
  .body p {
    margin: 1.2em 0;
  }
</style>
