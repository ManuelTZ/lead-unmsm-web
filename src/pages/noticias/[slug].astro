---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { news } from '@/data/news';
import { formatDate } from '@/lib/date';

export function getStaticPaths() {
  return news.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
---

<BaseLayout title={article.title} description={article.excerpt}>
  <article class="section">
    <div class="container article">
      <a class="back" href="/noticias">← Volver a noticias</a>
      <span class="tag">{article.category}</span>
      <h1 class="section-title">{article.title}</h1>
      <p class="meta">{formatDate(article.publishedAt)} · {article.author}</p>
      <p class="dek">{article.excerpt}</p>
      <div class="body">{article.body.map((paragraph) => <p>{paragraph}</p>)}</div>
      {
        article.isDemo && (
          <p class="card muted">Contenido de demostración. Reemplazar antes del lanzamiento.</p>
        )
      }
    </div>
  </article>
</BaseLayout>
<style>
  .article {
    max-width: 820px;
  }
  .back {
    display: block;
    margin-bottom: 26px;
    color: var(--muted);
    text-decoration: none;
  }
  .article h1 {
    margin-top: 18px;
  }
  .meta {
    color: var(--muted);
  }
  .dek {
    font-size: 1.25rem;
    color: #d5d5da;
  }
  .body {
    font-size: 1.06rem;
    color: #c5c5cc;
  }
  .body p {
    margin: 1.2em 0;
  }
</style>
