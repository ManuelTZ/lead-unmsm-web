---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsCard from '@/components/NewsCard.astro';
import { contentRepository } from '@/services/content/repository';
const news = await contentRepository.listNews();
---

<BaseLayout title="Noticias">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Radar STEM</p><h1 class="section-title">
        Noticias, referentes y oportunidades.
      </h1><p class="section-copy">
        Formato editorial pensado para que LEAD UNMSM publique contenido breve sin saturar la home.
      </p>
    </div>
  </section>
  <section class="section toned">
    <div class="container">
      {
        news.length > 0 ? (
          <div class="grid news-list">
            {news.map((article) => (
              <NewsCard article={article} />
            ))}
          </div>
        ) : (
          <div class="empty-state" role="status">
            <h2>Todavía no hay noticias publicadas.</h2>
            <p class="muted">
              Las novedades aparecerán aquí cuando el equipo editorial publique la primera.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
<style>
  .toned {
    background: #0c0c10;
    border-block: 1px solid var(--ink-800);
  }
  .news-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .empty-state {
    max-width: 760px;
  }
  .empty-state h2 {
    margin-top: 0;
  }
  @media (max-width: 720px) {
    .news-list {
      grid-template-columns: 1fr;
    }
  }
</style>
